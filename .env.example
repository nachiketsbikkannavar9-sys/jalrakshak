# ─────────────────────────────────────────────────────────────────────────────
# Jalrakshak — backend configuration
# Copy to backend/.env (and optionally repo root .env). Every variable has a
# working default except the optional alert-provider keys (below).
# ─────────────────────────────────────────────────────────────────────────────

# Database.
# Default points at the EMBEDDED PostgreSQL 18 that ships with the backend
# (zero-setup demo: no Docker, no root). In production set DATABASE_URL to
# Neon / Railway / Supabase and set AUTO_START_PG=0.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/jalrakshak
AUTO_START_PG=1

# Server
PORT=4000
PUBLIC_API_BASE=http://localhost:4000
JWT_SECRET=change-me-in-prod-please-a-random-string
JWT_TTL_HOURS=72

# Data adapters (comma separated). Sources are swappable at deploy time.
#   ukEA  → live river levels, UK Environment Agency API (no key, demo-day reliable)
#   usgs  → live gage heights, USGS Instantaneous Values API (no key, fallback)
#   nwdp  → REAL CWC/state telemetry via NWDP datastore (Godavari, Ganga, Brahmaputra gauges,
#           as-published hourly, no key) — INDIAN national data on the map
#   demo  → simulated Indian stations; "Brahmaputra at Guwahati" ramps past its
#           warning threshold → drives the alert demo (clearly labelled SIMULATED)
#   seed  → deterministic offline fallback (never an empty dashboard)
DATA_ADAPTERS=ukEA,demo,nwdp
POLL_INTERVAL_MIN=2
STATION_REFRESH_HR=6

# Real alert delivery ─────────────────────────────────────────────────────────
# Resend (email) and Twilio (SMS) have hackathon-friendly free tiers.
# Without keys, alerts still fire end-to-end into the app's alert feed/outbox
# via the "console-demo" channel (stored + visible, just not carrier-delivered).
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL_FROM=Jalrakshak Demo <onboarding@resend.dev>
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+15551234567

# Demo recipient list (team member / judge playing "NDRF control room").
# Email only — SMS is OFF until a real phone number + Twilio keys exist.
ALERT_RECIPIENTS=nachiketb588@gmail.com
# ALERT_RECIPIENT_PHONES=+919123456781
# ALERT_RECIPIENT_LABELS=NDRF Control Room (Demo)

# Authority account seeded at boot
AUTHORITY_EMAIL=ndrf@demo.local
AUTHORITY_PASSWORD=ChangeMe123!
AUTHORITY_NAME=NDRF Control Room (Demo)
AUTHORITY_ROLE=admin

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173