# ---- Jalrakshak backend configuration ----
# Copy to backend/.env (and/or root .env). Everything has a working default
# except the optional alert-provider keys, which are only needed to send REAL
# SMS/email. Without them, dispatches are "console/demo": still stored and
# visible in the app's outbox & alert feed, but not handed to a carrier.

# Database --------------------------------------------------------------
# Default points at the embedded PostgreSQL that ships with the backend
# (see src/db/embeddedPg.ts). In production set this to Neon/Railway/Supabase
# and set AUTO_START_PG=0.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/jalrakshak
AUTO_START_PG=1

# Server ----------------------------------------------------------------
PORT=4000
PUBLIC_API_BASE=http://localhost:4000
JWT_SECRET=change-me-in-prod-please-a-random-string
JWT_TTL_HOURS=72

# Which data adapters to run (comma separated).
#   ukEA  -> live river levels from UK Environment Agency API (no key, demo-day reliable)
#   usgs  -> live gauge heights from USGS Instantaneous Values API (no key, fallback)
#   demo  -> scripted simulated Indian stations (Brahmaputra ramps past warning: alert demo)
#   seed  -> deterministic offline fallback, so the demo never shows empty state
#   nwdp  -> REAL CWC/state telemetry via the National Water Data Portal (no key)
# Example: DATA_ADAPTERS=ukEA,demo,nwdp  (best demo: live UK + REAL Indian CWC telemetry + alert trigger)
DATA_ADAPTERS=ukEA,demo,nwdp
# Set to 1 to have the NWDP adapter log every raw upstream record before parsing
# (trace the exact column/values being read; useful when a gauge misbehaves).
# NWDP_DEBUG=1
POLL_INTERVAL_MIN=2
STATION_REFRESH_HR=6

# Real alert dispatch (optional) ----------------------------------------
# Email via Resend (no SDK needed). If absent, email alerts go to the demo outbox only.
# RESEND_API_KEY=re_xxxxxxxx
# ALERT_EMAIL_FROM=Jalrakshak Demo <onboarding@resend.dev>
ALERT_EMAIL_FROM=Jalrakshak Demo <demo@jalrakshak.local>

# SMS via Twilio. If absent, SMS alerts go to the demo outbox only.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+15551234567

# Demo recipient list (the team member / judge playing "NDRF control room").
# Email only — SMS is OFF until a real phone number + Twilio keys exist.
ALERT_RECIPIENTS=nachiketb588@gmail.com
# ALERT_RECIPIENT_PHONES=+919123456781
# ALERT_RECIPIENT_LABELS=NDRF Control Room (Demo)

# Authority account seeded at boot ---------------------------------------
AUTHORITY_EMAIL=ndrf@demo.local
AUTHORITY_PASSWORD=ChangeMe123!
AUTHORITY_NAME=NDRF Control Room (Demo)
AUTHORITY_ROLE=admin